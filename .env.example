# Copy to .env for local dev, or set these in your deploy platform (e.g. Vercel).
# Every variable is optional: the MCP endpoint (/api/mcp) needs none of them.

# Postgres connection string (e.g. Neon). Unset -> in-memory PGLite fallback,
# which resets on every process/cold start. migrations/*.sql are applied on
# both backends (scripts/migrate.mjs during build, src/lib/db.ts at runtime).
DATABASE_URL=

# Set to "false" to turn sign-in off (server functions use a dev user).
# Recommended on hosts other than the sandbox live preview unless the broker
# credentials below are provisioned.
VITE_AUTH_ENABLED=false

# Federated sign-in via the auth broker (src/lib/auth/server.ts). Unset -> the
# shared preview client, which the broker only accepts for *.grok-sandbox.com
# callbacks. Set all of these together for real auth on a public deployment.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Comma-separated STUN server URLs for multiplayer WebRTC (src/lib/multiplayer/p2p.ts).
VITE_STUN_URLS=
